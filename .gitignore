# Virtual environment
.venv/
venv/
env/

# Data cache (never commit raw prices)
data/
*.parquet

# Results (keep the CSV, ignore scratch)
results/*.png
results/*.tmp
# Regenerable run artefacts. Evidence that matters is recorded in docs/ and
# notes/ as a table, not as a generated file that can silently go stale.
results/*.json

# Whole run directories (e.g. results/EXP-*/ from run_experiment.py). These are
# outputs, not inputs, and are regenerated by one command — so they are ignored
# as directories rather than pattern-by-pattern, which is how one of them ends up
# swept into a commit by an over-broad `git add`.
results/*/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
dist/
build/
.DS_Store

# The working paper's generated inputs. Every measurement and the figure are
# written by scripts/build_paper.py from docs/published-run/; the PDF in
# essays/ is the artefact, and these two files are what produces it.
paper/generated/

# Local AI-agent prompt file: personal working instructions, not part of the
# repository. Never committed.
AGENTS.md
